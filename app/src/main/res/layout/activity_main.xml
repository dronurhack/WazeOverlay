<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D1A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Logo / Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚗"
            android:textSize="72sp"
            android:layout_marginTop="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WazeOverlay"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alertes Waze sur Google Maps"
            android:textColor="#9090B0"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="40dp" />

        <!-- Status card -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1A1A2E"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 Statut"
                    android:textColor="#CCCCEE"
                    android:textSize="13sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Vérification des permissions…"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:lineSpacingMultiplier="1.4" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Notification access button -->
        <Button
            android:id="@+id/btn_notif_access"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🔔 Accès aux notifications"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1E3A5F"
            android:textSize="15sp"
            android:layout_marginBottom="12dp"
            android:cornerRadius="12dp" />

        <!-- Main CTA button -->
        <Button
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="🔑 Configurer les permissions"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4361EE"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp"
            android:cornerRadius="14dp" />

        <!-- Instructions card -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#12122A"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📖 Comment utiliser"
                    android:textColor="#9090CC"
                    android:textSize="13sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1️⃣  Ouvre Waze et lance ta route (ou sans destination)\n\n2️⃣  Reviens à l'écran d'accueil — Waze tourne en fond\n\n3️⃣  Ouvre Google Maps et lance ta navigation\n\n4️⃣  Les alertes Waze apparaîtront automatiquement :\n     🚨 Police   📷 Radar   💥 Accident\n     🚧 Travaux  🚦 Trafic  ⚠️ Danger\n\n5️⃣  Appuie sur ✅ Toujours là ou ❌ Disparu pour\n     confirmer le signalement directement dans Waze"
                    android:textColor="#AAAACC"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.5" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WazeOverlay v1.0 — Pour les livreurs 📦"
            android:textColor="#44445A"
            android:textSize="12sp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
